<odoo>

    <record id="crm_lead_rotation_list" model="ir.ui.view">
        <field name="name">crm.lead.rotation.list</field>
        <field name="model">crm.lead.rotation</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_rotation"/>
                <field name="user_from_id"/>
                <field name="user_to_id"/>
                <field name="rotation_type"/>
                <field name="days_with_seller"/>
                <field name="rotation_sequence"/>
                <field name="lead_id"/>
            </list>
        </field>
    </record>

    <record id="crm_lead_rotation_form" model="ir.ui.view">
        <field name="name">crm.lead.rotation.form</field>
        <field name="model">crm.lead.rotation</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="lead_id"/>
                    <field name="rotation_sequence"/>
                    <field name="date_rotation"/>
                    <field name="rotation_type"/>
                    <field name="user_from_id"/>
                    <field name="user_to_id"/>
                    <field name="days_with_seller"/>
                    <field name="notes"/>
                </group>
            </form>
        </field>
    </record>

    <record id="crm_lead_rotation_search" model="ir.ui.view">
        <field name="name">crm.lead.rotation.search</field>
        <field name="model">crm.lead.rotation</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <filter name="group_by_user_from_id" string="Vendedor Origem"
                        domain="[]" context="{'group_by': 'user_from_id'}"/>
                <filter name="group_by_user_to_id" string="Vendedor Destino"
                        domain="[]" context="{'group_by': 'user_to_id'}"/>
                <filter name="group_by_rotation_type" string="Tipo de Rotação"
                        domain="[]" context="{'group_by': 'rotation_type'}"/>
                <separator/>
                <filter name="my_rotations" string="Minhas Rotações"
                        domain="[('user_from_id', '=', uid)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_user_from" string="Vendedor Origem"
                            context="{'group_by': 'user_from_id'}"/>
                    <filter name="group_by_user_to" string="Vendedor Destino"
                            context="{'group_by': 'user_to_id'}"/>
                    <filter name="group_by_type" string="Tipo"
                            context="{'group_by': 'rotation_type'}"/>
                    <filter name="group_by_date" string="Data"
                            context="{'group_by': 'date_rotation:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crm_lead_rotation_report" model="ir.actions.server">
        <field name="name">Histórico de Rotações</field>
        <field name="model_id" ref="model_crm_lead_rotation"/>
        <field name="binding_model_id" ref="model_crm_lead_rotation"/>
        <field name="state">code</field>
        <field name="code">action = env['crm.lead.rotation'].action_rotation_report()</field>
    </record>

    <menuitem id="menu_crm_rotation_report"
              name="Histórico de Rotações"
              parent="crm.crm_menu_report"
              action="action_crm_lead_rotation_report"
              sequence="5"
              groups="sales_team.group_sale_salesman"/>

</odoo>
