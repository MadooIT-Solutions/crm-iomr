<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_referred_partner" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.referred.partner</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='probability']" position="after">
                <group>
                    <group>
                        <field name="referred_partner" widget="many2many_tags"/>
                        <field name="convenio"/>
                        <field name="doctor" string="Médico"/>
                    </group>
                    <group>
                        <field name="expected_revenue" string="Orçamento"/>
                        <field name="date" string="Data"/>
                        <field name="date_contact" string="Data do Contato"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//page[@name='lead']" position="after">
                <page name="import" string="Dados de Importação">
                    <group>
                        <field name="id_orc" string="Id do Klingo"/>
                        <field name="state_klingo" string="Status"/>
                        <field name="motives"/>
                    </group>
                </page>

            </xpath>

            <xpath expr="//button[@name='action_set_won']" position="before">
                <button name="action_rotate_seller"
                        string="Rotacionar Vendedor"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('all_sellers_exhausted', '=', True)]}"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                        name="action_open_rotation_history"
                        class="oe_stat_button"
                        icon="fa-history">
                    <field name="rotation_count" widget="statinfo"/>
                </button>
            </xpath>

            <xpath expr="//group" position="inside">
                <group string="Informações de Rotação"
                       attrs="{'invisible': [('rotation_count', '=', 0)]}">
                    <field name="rotation_count"/>
                    <field name="date_assigned_to_seller"/>
                    <field name="days_with_current_seller"/>
                    <field name="all_sellers_exhausted"/>
                    <field name="last_activity_date"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Lista de histórico de rotação -->
    <record id="crm_lead_rotation_list" model="ir.ui.view">
        <field name="name">crm.lead.rotation.tree</field>
        <field name="model">crm.lead.rotation</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date_rotation"/>
                <field name="user_from_id"/>
                <field name="user_to_id"/>
                <field name="rotation_type"/>
                <field name="days_with_seller"/>
                <field name="rotation_sequence"/>
            </tree>
        </field>
    </record>

    <record id="rule_crm_lead_by_team" model="ir.rule">
        <field name="name">CRM Lead: see only own team</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('team_id', '=', user.sale_team_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>