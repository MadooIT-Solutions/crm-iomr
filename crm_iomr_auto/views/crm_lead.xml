<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="crm_lead_view_form_inherit_referred_partner" model="ir.ui.view">
    <field name="name">crm.lead.form.inherit.referred.partner</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">

      <xpath expr="//field[@name='tag_ids']" position="replace"/>
      <xpath expr="//field[@name='user_id']" position="replace"/>


      <xpath expr="//group[@name='lead_partner']" position="before">

        <group>
          <group>
            <field name="referred_partner" widget="many2many_tags" options="{'no_create':true}"/>
            <field name="convenio" options="{'no_create':true}"/>
            <field name="tipo_venda" widget="radio"/>
            <field name="doctor" string="Médico(a)" options="{'no_create':true}"/>
            <field name="user_id"/>

          </group>
          <group>
            <field name="expected_revenue" string="Orçamento"/>
            <field name="date" string="Data"/>
            <field name="date_contact" string="Data do Contato"/>

            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
          </group>
        </group>

      </xpath>


      <xpath expr="//field[@name='partner_phone_update']" position="after">
        <field name="prontuario" id="prontuario_lead_contact"/>
      </xpath>

      <xpath expr="//div[hasclass('o_row')][field[@name='phone']]" position="after">

        <label for="mobile_lead_contact" class="oe_inline"/>
        <div class="o_row o_row_readonly">
          <field name="mobile" id="mobile_lead_contact" widget="phone"/>
          <button type="object" name="action_initiate_whatsapp_call" class="btn-sm btn-link fa fa-phone" aria-label="Iniciar Chamada" title="Iniciar Chamada" invisible="not partner_id or not (partner_id.mobile or mobile)" groups="tus_meta_whatsapp_base.whatsapp_group_user"/>
        </div>
      </xpath>





      <xpath expr="//page[@name='lead']" position="after">
        <page name="import" string="Dados de Importação">
          <group>
            <field name="id_orc" string="Id do Klingo"/>
            <field name="state_klingo" string="Status"/>
            <field name="motives"/>
          </group>
        </page>

      </xpath>

      <xpath expr="//button[@name='action_set_won_rainbowman']" position="before">
        <button name="action_rotate_seller" string="Rotacionar Vendedor(a)" type="object" class="oe_highlight" invisible="not can_rotate or all_sellers_exhausted"/>
      </xpath>

      <xpath expr="//div[@name='button_box']" position="inside">
        <button type="object" name="action_open_rotation_history" class="oe_stat_button" icon="fa-history">
          <field name="rotation_count" widget="statinfo"/>
        </button>
      </xpath>

      <xpath expr="//group[group[@name='lead_partner']]" position="inside">
        <group string="Informações de Rotação" invisible="rotation_count == 0">
          <field name="rotation_count" readonly="1"/>
          <field name="date_assigned_to_seller" readonly="1"/>
          <field name="days_with_current_seller" readonly="1"/>
          <field name="all_sellers_exhausted" readonly="1"/>
          <field name="last_activity_date" readonly="1"/>
        </group>
      </xpath>

    </field>
  </record>

  <record id="crm_lead_view_list_iomr" model="ir.ui.view">
    <field name="name">crm.lead.list.iomr</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="inside">
        <field name="referred_partner"/>
        <field name="convenio" />
        <field name="doctor" string="Médico(a)"/>
      </xpath>

    </field>
  </record>

  <record id="crm_lead_search_leads_inherit_prontuario" model="ir.ui.view">
    <field name="name">crm.lead.search.leads.inherit.prontuario</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.view_crm_case_leads_filter" />
    <field name="arch" type="xml">
      <field name="user_id" position="after">
        <field name="prontuario" />
      </field>
    </field>
  </record>
  <record id="crm_lead_search_opportunities_inherit_prontuario" model="ir.ui.view">
    <field name="name">crm.lead.search.opportunities.inherit.prontuario</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter" />
    <field name="arch" type="xml">
      <field name="user_id" position="after">
        <field name="prontuario" />
      </field>
    </field>
  </record>
  <record id="rule_crm_lead_by_team" model="ir.rule">
    <field name="name">CRM Lead: see only own team</field>
    <field name="model_id" ref="crm.model_crm_lead"/>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    <field name="domain_force">[('team_id', '=', user.sale_team_id.id)]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

</odoo>
