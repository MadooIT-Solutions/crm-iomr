<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">
        <record id="ir_cron_check_rotation" model="ir.cron">
            <field name="name">CRM: Verificar Regras de Rotação</field>
            <field name="model_id" ref="model_crm_lead_rotation"/>
            <field name="state">code</field>
            <field name="code">model.check_rotation_rules()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">24</field>
            <field name="interval_type">hours</field>
        </record>

        <record id="ir_cron_validate_activity" model="ir.cron">
            <field name="name">CRM: Validar Atividades Obrigatórias</field>
            <field name="model_id" ref="model_crm_lead_rotation"/>
            <field name="state">code</field>
            <field name="code">model.validate_next_activity_requirement()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">24</field>
            <field name="interval_type">hours</field>
        </record>
    </data>
</odoo>
