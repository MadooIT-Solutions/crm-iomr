<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Checar regras de rotação a cada 24 horas -->
        <record id="ir_cron_check_rotation" model="ir.cron">
            <field name="name">CRM: Verificar Regras de Rotação</field>
            <field name="model_id" ref="base.model_ir_cron"/>
            <field name="state">code</field>
            <field name="code">env['crm.rotation.service'].check_rotation_rules()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">24</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
        </record>

        <!-- Validar atividades obrigatórias a cada 24 horas -->
        <record id="ir_cron_validate_activity" model="ir.cron">
            <field name="name">CRM: Validar Atividades Obrigatórias</field>
            <field name="model_id" ref="base.model_ir_cron"/>
            <field name="state">code</field>
            <field name="code">env['crm.rotation.service'].validate_next_activity_requirement()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">24</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
        </record>
    </data>
</odoo>