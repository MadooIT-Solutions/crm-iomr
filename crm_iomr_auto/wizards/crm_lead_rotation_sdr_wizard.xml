<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_rotation_sdr_wizard_form" model="ir.ui.view">
        <field name="name">crm.lead.rotation.sdr.wizard.form</field>
        <field name="model">crm.lead.rotation.sdr.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="mt4 mb4">Não há mais vendedores disponíveis na equipe. Deseja encaminhar a oportunidade para o SDR?</p>
                <field name="lead_id" invisible="1"/>
                <field name="sdr_user_id" invisible="1"/>
                <footer>
                    <button name="action_confirm" string="Sim, encaminhar para SDR" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
