<odoo noupdate="1">
    <record id="commission_progressive_lios" model="commission">
        <field name="name">Comissão Progressiva LIOs</field>
        <field name="commission_type">progressive</field>
        <field name="amount_base_type">gross_amount</field>
        <field name="is_crm_bonus">0.25</field>
        <field name="is_crm_penalty">0.25</field>
        <field name="min_margin">35.0</field>
        <field name="max_discount">5.0</field>
    </record>

    <record id="progressive_line_1" model="commission.progressive.line">
        <field name="commission_id" ref="commission_progressive_lios" />
        <field name="sequence">10</field>
        <field name="percent_from">0.0</field>
        <field name="percent_to">50.0</field>
        <field name="commission_percent">0.25</field>
    </record>
    <record id="progressive_line_2" model="commission.progressive.line">
        <field name="commission_id" ref="commission_progressive_lios" />
        <field name="sequence">20</field>
        <field name="percent_from">51.0</field>
        <field name="percent_to">80.0</field>
        <field name="commission_percent">0.45</field>
    </record>
    <record id="progressive_line_3" model="commission.progressive.line">
        <field name="commission_id" ref="commission_progressive_lios" />
        <field name="sequence">30</field>
        <field name="percent_from">81.0</field>
        <field name="percent_to">100.0</field>
        <field name="commission_percent">0.75</field>
    </record>
    <record id="progressive_line_4" model="commission.progressive.line">
        <field name="commission_id" ref="commission_progressive_lios" />
        <field name="sequence">40</field>
        <field name="percent_from">101.0</field>
        <field name="percent_to">120.0</field>
        <field name="commission_percent">1.25</field>
    </record>
    <record id="progressive_line_5" model="commission.progressive.line">
        <field name="commission_id" ref="commission_progressive_lios" />
        <field name="sequence">50</field>
        <field name="percent_from">120.01</field>
        <field name="percent_to">999.0</field>
        <field name="commission_percent">1.75</field>
    </record>

    <record id="commission_fixed_1pct_extras" model="commission">
        <field name="name">Comissão Fixa 1% (Taxa Sala / Mat-Med / Cola)</field>
        <field name="commission_type">fixed</field>
        <field name="fix_qty">1.0</field>
        <field name="amount_base_type">gross_amount</field>
        <field name="settlement_type">sale_invoice</field>
    </record>

    <record id="commission_coordinator_policy" model="commission">
        <field name="name">Comissão Coordenadora (via política)</field>
        <field name="commission_type">coordinator</field>
        <field name="amount_base_type">gross_amount</field>
        <field name="settlement_type">sale_invoice</field>
    </record>

    <!-- Repasse Médico - Consulta: 60% sobre receita líquida (impostos 16.33% + taxa cartão) -->
    <record id="commission_doctor_consulta" model="commission">
        <field name="name">Repasse Médico - Consulta</field>
        <field name="commission_type">fixed</field>
        <field name="fix_qty">60.0</field>
        <field name="amount_base_type">net_amount_deduction</field>
        <field name="tax_deduction_pct">16.33</field>
        <field name="deduct_card_fee" eval="True"/>
        <field name="settlement_type">sale_invoice</field>
    </record>

    <!-- Repasse Médico - Exame: 50% sobre receita líquida (impostos 11.73% + taxa cartão) -->
    <record id="commission_doctor_exame" model="commission">
        <field name="name">Repasse Médico - Exame</field>
        <field name="commission_type">fixed</field>
        <field name="fix_qty">50.0</field>
        <field name="amount_base_type">net_amount_deduction</field>
        <field name="tax_deduction_pct">11.73</field>
        <field name="deduct_card_fee" eval="True"/>
        <field name="settlement_type">sale_invoice</field>
    </record>

    <!-- Repasse Médico - Cirurgia (honorário): 100% sobre receita líquida (impostos 11.73% + taxa cartão) -->
    <record id="commission_doctor_cirurgia" model="commission">
        <field name="name">Repasse Médico - Cirurgia (Honorário)</field>
        <field name="commission_type">fixed</field>
        <field name="fix_qty">100.0</field>
        <field name="amount_base_type">net_amount_deduction</field>
        <field name="tax_deduction_pct">11.73</field>
        <field name="deduct_card_fee" eval="True"/>
        <field name="settlement_type">sale_invoice</field>
    </record>
</odoo>
