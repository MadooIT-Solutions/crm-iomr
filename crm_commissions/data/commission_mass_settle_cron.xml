<odoo noupdate="1">

    <!-- Cron de Fechamento em Lote Mensal -->
    <record id="cron_commission_mass_settle_monthly" model="ir.cron">
        <field name="name">CRM Comissões: Fechamento em Lote Mensal</field>
        <field name="model_id" ref="model_commission_mass_settle"/>
        <field name="state">code</field>
        <field name="code">model._cron_mass_settle()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="nextcall">2026-11-01 02:00:00</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Cron de Criação de Faturas Mensal -->
    <record id="cron_commission_mass_invoice_monthly" model="ir.cron">
        <field name="name">CRM Comissões: Criação de Faturas Mensal</field>
        <field name="model_id" ref="model_commission_mass_invoice"/>
        <field name="state">code</field>
        <field name="code">model._cron_mass_invoice()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="nextcall">2026-11-05 02:00:00</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
