<odoo>

    <record id="commission_mass_invoice_form" model="ir.ui.view">
        <field name="name">commission.mass.invoice.form</field>
        <field name="model">commission.mass.invoice</field>
        <field name="arch" type="xml">
            <form string="Criação de Faturas de Pagamento">
                <group>
                    <group string="Faturamento">
                        <field name="journal_id"/>
                        <field name="product_id"/>
                        <field name="date"/>
                        <field name="group_by"/>
                    </group>
                    <group string="Filtros">
                        <field name="team_ids" widget="many2many_tags"/>
                        <field name="agent_ids" widget="many2many_tags"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <group string="Settlements para Faturamento">
                    <field name="settlement_ids" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="agent_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="total"/>
                            <field name="state"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_preview"
                            string="Revisar"
                            type="object"/>
                    <button name="action_create_invoices"
                            string="Criar Faturas"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_commission_mass_invoice" model="ir.actions.act_window">
        <field name="name">Faturas de Pagamento</field>
        <field name="res_model">commission.mass.invoice</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
