<odoo>

    <!-- Deixa rastreável a origem de cada linha fechada no CRM: a meta mensal
         que gerou a comissão de performance ou o bônus trimestral cuja
         comissão perdida foi recuperada. -->
    <record id="view_settlement_form_crm_sources" model="ir.ui.view">
        <field name="name">commission.settlement.form.crm.sources</field>
        <field name="model">commission.settlement</field>
        <field name="inherit_id" ref="commission_oca.view_settlement_form" />
        <field name="arch" type="xml">
            <xpath expr="//list[@editable='top']" position="inside">
                <!-- O pedido de venda que originou a linha, e o clique que
                     abre esse pedido. -->
                <field name="sale_order_id" readonly="1" optional="show" />
                <button
                    name="action_open_sale_order"
                    type="object"
                    icon="fa-external-link"
                    title="Abrir pedido de venda"
                />
                <!-- As duas colunas abaixo só têm conteúdo nos fechamentos
                     do CRM: as linhas de fatura vêm da fatura e não têm
                     meta nem bônus, então aparecem vazias. -->
                <field
                    name="target_id"
                    optional="hide"
                    column_invisible="parent.settlement_type != 'crm_performance'"
                />
                <field
                    name="quarterly_bonus_id"
                    optional="hide"
                    column_invisible="parent.settlement_type != 'crm_quarterly_recovery'"
                />
            </xpath>
        </field>
    </record>

    <record id="view_settlement_line_list_crm_sources" model="ir.ui.view">
        <field name="name">commission.settlement.line.list.crm.sources</field>
        <field name="model">commission.settlement.line</field>
        <field name="inherit_id" ref="commission_oca.view_settlement_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="sale_order_id" readonly="1" optional="show" />
                <button
                    name="action_open_sale_order"
                    type="object"
                    icon="fa-external-link"
                    title="Abrir pedido de venda"
                />
                <field name="target_id" optional="hide" />
                <field name="quarterly_bonus_id" optional="hide" />
            </xpath>
        </field>
    </record>

</odoo>
