<odoo>
    <menuitem
        id="menu_crm_commission_root"
        name="Repasses"
        parent="crm.crm_menu_root"
        sequence="50"
        groups="group_crm_commission_user"
    />
    <record id="action_crm_commission_dashboard" model="ir.actions.act_url">
        <field name="name">Dashboard</field>
        <field name="url">/dashboard/commission</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="menu_crm_commission_dashboard"
        name="Dashboard"
        parent="menu_crm_commission_root"
        action="action_crm_commission_dashboard"
        sequence="5"
    />
    <menuitem
        id="menu_crm_commission_targets"
        name="Metas Mensais"
        parent="menu_crm_commission_root"
        action="action_crm_commission_target"
        sequence="10"
    />
    <menuitem
        id="menu_crm_quarterly_bonus"
        name="Bônus Trimestrais"
        parent="menu_crm_commission_root"
        action="action_crm_quarterly_bonus"
        sequence="30"
        groups="group_crm_commission_manager"
    />
    <menuitem
        id="menu_crm_lios_config"
        name="Config. Repasse LIOs"
        parent="menu_crm_commission_root"
        action="commission_oca.action_commission"
        sequence="40"
        groups="group_crm_commission_manager"
    />

    <!-- Grant CRM and Sales menu access to Visualização Total (read-only) -->
    <record id="crm.crm_menu_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_crm_readonly'))]"/>
    </record>
    <record id="sale.menu_sale_quotations" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_crm_readonly'))]"/>
    </record>
    <record id="sale.menu_sale_order" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_crm_readonly'))]"/>
    </record>
    <record id="sale.res_partner_menu" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_crm_readonly'))]"/>
    </record>
</odoo>
