<odoo>
    <record id="crm_lead_form_inherit_commission" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.commission</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page name="crm_commission" string="CRM Comissão">
                    <group>
                        <group string="Equipe Comercial">
                            <field name="doctor" invisible="1" />
                        </group>
                        <group string="Comissão">
                            <field name="is_crm_score" widget="progressbar" />
                            <field name="commission_percent" />
                            <field name="discount_percent" />
                            <field name="discount_approved" />
                            <field name="margin_percent" />
                            <field name="margin_ok" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="crm_lead_search_leads_inherit_commission" model="ir.ui.view">
        <field name="name">crm.lead.search.leads.inherit.commission</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="doctor" />
            </field>
        </field>
    </record>
    <record id="crm_lead_search_opportunities_inherit_commission" model="ir.ui.view">
        <field name="name">crm.lead.search.opportunities.inherit.commission</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="doctor" />
            </field>
        </field>
    </record>
</odoo>
