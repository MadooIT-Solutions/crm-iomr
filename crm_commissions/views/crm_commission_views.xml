<odoo>

    <record id="crm_commission_target_tree" model="ir.ui.view">
        <field name="name">crm.commission.target.list</field>
        <field name="model">crm.commission.target</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="agent_id" />
                <field name="target_date" />
                <field name="target_amount" widget="monetary" />
                <field name="achieved_amount" widget="monetary" />
                <field name="performance_pct" widget="progressbar" />
                <field name="is_crm_score" widget="progressbar" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="crm_commission_target_form" model="ir.ui.view">
        <field name="name">crm.commission.target.form</field>
        <field name="model">crm.commission.target</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_apply_team"
                        string="Aplicar à Equipe"
                        type="object"
                        class="btn-primary"
                        confirm="Criar a meta mensal para todos os vendedores (orientadoras) da equipe selecionada?"
                        invisible="target_scope != 'team'"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="target_scope" widget="radio" options="{'horizontal': True}" />
                    </group>
                    <group>
                        <group>
                            <field name="name" readonly="1" />
                            <field name="agent_id" invisible="target_scope != 'salesperson'" />
                            <field
                                name="team_id"
                                invisible="target_scope != 'team'"
                                required="target_scope == 'team'"
                            />
                            <field name="target_date" />
                        </group>
                        <group>
                            <field name="target_amount" widget="monetary" />
                            <field name="achieved_amount" widget="monetary" />
                            <field name="quarterly_target_amount" widget="monetary" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="performance_pct" widget="progressbar" />
                            <field name="is_crm_score" />
                            <field name="is_crm_ok" />
                        </group>
                        <group>
                            <field name="state" />
                            <field name="quarter" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_commission_target_search" model="ir.ui.view">
        <field name="name">crm.commission.target.search</field>
        <field name="model">crm.commission.target</field>
        <field name="arch" type="xml">
            <search>
                <field name="agent_id" />
                <field name="target_date" />
                <filter
                    name="this_month"
                    string="Este mês"
                    domain="[('target_date', '>=', time.strftime('%%Y-%%m-01'))]"
                />
                <separator />
                <group expand="1" string="Group By">
                    <filter name="group_agent" string="Vendedor" context="{'group_by': 'agent_id'}" />
                    <filter name="group_quarter" string="Trimestre" context="{'group_by': 'quarter'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_crm_commission_target" model="ir.actions.act_window">
        <field name="name">Metas Mensais</field>
        <field name="res_model">crm.commission.target</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="crm_commission_target_search" />
    </record>

    <record id="crm_quarterly_bonus_tree" model="ir.ui.view">
        <field name="name">crm.commission.quarterly.bonus.list</field>
        <field name="model">crm.commission.quarterly.bonus</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="agent_id" />
                <field name="team_id" optional="show" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="target_count" />
                <field name="has_all_months" widget="boolean_toggle" />
                <field name="total_target" widget="monetary" />
                <field name="total_achieved" widget="monetary" />
                <field name="quarterly_pct" widget="progressbar" />
                <field name="is_eligible" widget="boolean_toggle" />
                <field name="is_team_eligible" widget="boolean_toggle" optional="show" />
                <field name="lost_commission_recovered" widget="monetary" optional="show" />
                <field name="bonus_amount" widget="monetary" optional="show" />
                <field name="state" widget="badge" />
                <field name="auto_generated" widget="boolean_toggle" optional="hide" />
                <field name="currency_id" invisible="1" />
            </list>
        </field>
    </record>

    <record id="crm_quarterly_bonus_form" model="ir.ui.view">
        <field name="name">crm.commission.quarterly.bonus.form</field>
        <field name="model">crm.commission.quarterly.bonus</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_finalize_quarter"
                        string="Atualizar e finalizar trimestre"
                        type="object"
                        class="btn-primary"
                        invisible="not date_to or date_to >= current_date"
                        confirm="Atualizar os totais e finalizar este trimestre?"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="pending,eligible,recovered,lost" />
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="auto_generated">
                        Registro criado manualmente. Ao cadastrar uma meta mensal da vendedora, o sistema vinculará e manterá os três meses automaticamente.
                    </div>
                    <group>
                        <group>
                            <field name="agent_id" readonly="auto_generated" />
                            <field name="team_id" readonly="auto_generated" />
                            <field name="quarter" readonly="auto_generated" />
                            <field name="year" readonly="auto_generated" />
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="auto_generated" />
                        </group>
                        <group>
                            <field name="target_count" />
                            <field name="has_all_months" />
                            <field name="missing_months" invisible="has_all_months" />
                            <field name="is_finalized" />
                            <field name="is_eligible" />
                            <field name="currency_id" invisible="1" />
                        </group>
                    </group>
                    <group string="Performance individual">
                        <group>
                            <field name="total_target" widget="monetary" />
                            <field name="total_achieved" widget="monetary" />
                            <field name="quarterly_pct" widget="progressbar" />
                        </group>
                        <group>
                            <field name="lost_commission_recovered" widget="monetary" />
                            <field name="bonus_amount" widget="monetary" />
                            <field name="prize_type" />
                            <field name="prize_description" />
                        </group>
                    </group>
                    <group string="Elegibilidade coletiva / coordenadora">
                        <group>
                            <field name="team_total_target" widget="monetary" />
                            <field name="team_total_achieved" widget="monetary" />
                        </group>
                        <group>
                            <field name="team_quarterly_pct" widget="progressbar" />
                            <field name="is_team_eligible" />
                        </group>
                    </group>
                    <group string="Metas mensais vinculadas">
                        <field name="monthly_targets" nolabel="1">
                            <list>
                                <field name="target_date" />
                                <field name="target_amount" widget="monetary" />
                                <field name="achieved_amount" widget="monetary" />
                                <field name="performance_pct" widget="progressbar" />
                                <field name="state" />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_quarterly_bonus" model="ir.actions.act_window">
        <field name="name">Bônus Trimestrais</field>
        <field name="res_model">crm.commission.quarterly.bonus</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Extend commission form to add progressive rates -->
    <record id="commission_form_inherit_progressive" model="ir.ui.view">
        <field name="name">commission.form.inherit.progressive</field>
        <field name="model">commission</field>
        <field name="inherit_id" ref="commission_oca.commission_form" />
        <field name="arch" type="xml">
            <field name="commission_type" position="after">
                <field name="is_crm_bonus" invisible="commission_type != 'progressive'" />
                <field name="is_crm_penalty" invisible="commission_type != 'progressive'" />
                <field name="min_margin" invisible="commission_type != 'progressive'" />
                <field name="max_discount" invisible="commission_type != 'progressive'" />
                <field name="categ_ids" invisible="commission_type != 'progressive'" widget="many2many_tags" />
                <field
                    name="tax_deduction_pct"
                    invisible="amount_base_type != 'net_amount_deduction'"
                />
                <field
                    name="deduct_card_fee"
                    invisible="amount_base_type != 'net_amount_deduction'"
                />
            </field>
            <field name="section_ids" position="after">
                <field
                    name="progressive_line_ids"
                    invisible="commission_type != 'progressive'"
                    nolabel="1"
                    colspan="4"
                >
                    <list editable="bottom">
                        <field name="sequence" />
                        <field name="percent_from" />
                        <field name="percent_to" />
                        <field name="commission_percent" />
                    </list>
                </field>
            </field>
        </field>
    </record>
</odoo>
