<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="portal_my_home_doctor_cleanup" name="Portal Home Doctor Cleanup" inherit_id="portal.portal_my_home" priority="100">
  <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
    <t t-set="portal_alert_category_enable" t-value="False"/>
    <t t-set="portal_client_category_enable" t-value="False"/>
    <t t-set="portal_service_category_enable" t-value="False"/>
    <t t-set="portal_vendor_category_enable" t-value="False"/>
  </xpath>
  <xpath expr="//div[@id='portal_common_category']/t[2]" position="replace"/>
  <xpath expr="//div[hasclass('o_portal_my_home')]" position="inside">
    <script>document.getElementById('wrapwrap').classList.add('o_portal_doctor_home')</script>
  </xpath>
</template>

<template id="portal_commission_opportunities" name="My Commission Opportunities" inherit_id="portal.portal_my_home">
<xpath expr="//div[@id='portal_common_category']" position="inside">
<t t-call="portal.portal_docs_entry">
<t t-set="title">Minhas Oportunidades e Repasses</t>
<t t-set="text">Visualize suas oportunidades e repasses vinculados.</t>
<t t-set="url" t-value="'/my/opportunities'"/>
<t t-set="config_card" t-value="True"/>
</t>
<t t-if="request.env.user.partner_id.show_repasse_table">
<t t-call="portal.portal_docs_entry">
<t t-set="title">Tabela de Repasses</t>
<t t-set="text">Consulte as regras de repasse por tipo de serviço.</t>
<t t-set="url" t-value="'/my/repasse-rules'"/>
<t t-set="config_card" t-value="True"/>
</t>
</t>

</xpath>
</template>

<template id="portal_my_opportunities_list" name="My Opportunities List">
<t t-call="portal.portal_layout">
<t t-set="breadcrumbs">
<ol class="breadcrumb">
<li class="breadcrumb-item"><a href="/my">Home</a></li>
<li class="breadcrumb-item active">Minhas Oportunidades e Repasses</li>
</ol>
</t>

<div class="o_portal_doctor">

<form method="get" action="/my/opportunities" class="row mb-3 align-items-end">
  <div class="col-auto">
    <label class="form-label small text-muted mb-1">Data Início</label>
    <input type="date" name="date_from" class="form-control form-control-sm" t-att-value="date_from"/>
  </div>
  <div class="col-auto">
    <label class="form-label small text-muted mb-1">Data Fim</label>
    <input type="date" name="date_to" class="form-control form-control-sm" t-att-value="date_to"/>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-sm btn-primary mt-3">Filtrar</button>
  </div>
</form>

<div class="row mb-3">
<div class="col-12">
<h5 class="text-muted mb-2">Resumo por Estágio</h5>
<div class="d-flex flex-wrap gap-2">
<t t-raw="summary_cards_html"/>
<t t-raw="total_card_html"/>
</div>
</div>
</div>

<div class="row mb-3" t-if="show_all_values">
<div class="col-12">
<h5 class="text-muted mb-2">Ganhos e Não Faturados</h5>
<div class="d-flex flex-wrap gap-2">
<div class="card o_portal_commission_card" style="min-width:160px">
<div class="card-body py-3 px-3 text-center" style="background-color:#8EBAA6;border-radius:12px">
<div class="fw-bold small text-uppercase mb-1" style="color:#ffffff">Total Ganhos</div>
<div><span class="fw-bold" style="color:#ffffff">R$ <t t-esc="ganhos_total_fmt"/></span></div>
</div></div>
<div class="card o_portal_commission_card" style="min-width:160px">
<div class="card-body py-3 px-3 text-center" style="background-color:#8EBAA6;border-radius:12px">
<div class="fw-bold small text-uppercase mb-1" style="color:#ffffff">Faturado</div>
<div><span class="fw-bold" style="color:#ffffff">R$ <t t-esc="faturado_total_fmt"/></span></div>
</div></div>
<div class="card o_portal_commission_card" style="min-width:160px">
<div class="card-body py-3 px-3 text-center" style="background-color:#8EBAA6;border-radius:12px">
<div class="fw-bold small text-uppercase mb-1" style="color:#ffffff">Não Faturado</div>
<div><span class="fw-bold" style="color:#ffffff">R$ <t t-esc="nao_faturado_total_fmt"/></span></div>
</div></div>
</div>
</div>
</div>

<div class="row mb-4">
<div class="col-12">
<h3>Oportunidades em Aberto</h3>
</div>
</div>
<div class="row mb-4">
<div class="col-12">
<t t-if="not open_opportunities">
<p class="text-muted">Nenhuma oportunidade em aberto no período.</p>
</t>
    <t t-if="open_opportunities">
        <t t-raw="accordion_html"/>
    </t>
</div>
</div>

<div class="row mb-4">
<div class="col-12">
<h3>Oportunidades Convertidas</h3>
</div>
</div>
<div class="row mb-4">
<div class="col-12">
<t t-if="not pending_data">
<p class="text-muted">Nenhuma oportunidade convertida no período.</p>
</t>
<t t-if="pending_data">
<table class="table table-striped">
<thead>
<tr>
                            <th>Pedido</th>
                            <th>Cliente</th>
                            <th>Data</th>
                            <th>Oportunidade</th>
                            <th>Indicações</th>
                            <th t-if="show_all_values">Valor</th>
</tr>
</thead>
<tbody>
<tr t-foreach="pending_data" t-as="pd">
<td><t t-esc="pd['order_name']"/></td>
<td><t t-esc="pd['partner_name']"/></td>
<td><t t-esc="pd['order_date']"/></td>
                            <td><t t-esc="pd['opportunity_name']"/></td>
                            <td><t t-esc="pd['referred_names']"/></td>
                            <td t-if="show_all_values">R$ <t t-esc="pd['amount_fmt']"/></td>
</tr>
</tbody>
</table>
</t>
</div>
</div>

<div t-if="show_all_values">
<div class="row mb-4">
<div class="col-12">
<h3>Meus Repasses</h3>
</div>
</div>
<div class="row">
<div class="col-12">
<t t-if="not settlements">
<p class="text-muted">Nenhum repasse registrado no período.</p>
</t>
<t t-if="settlements">
<table class="table table-striped">
<thead>
<tr>
<th>Repasse</th>
<th>Período</th>
<th t-if="show_all_values">Valor</th>
<th>Estado</th>
<th>Pedido</th>
<th>Status Pagamento</th>
</tr>
</thead>
<tbody>
<t t-foreach="settlements" t-as="s">
<t t-foreach="s['lines']" t-as="line_data">
<tr>
<td><t t-esc="s['settlement'].name or ''"/></td>
<td><t t-esc="s['settlement'].date_from"/> a <t t-esc="s['settlement'].date_to"/></td>
<td t-if="show_all_values"><t t-esc="line_data['line'].settled_amount"/></td>
<td>
<t t-if="s['settlement'].state == 'settled'">Liquidado</t>
<t t-if="s['settlement'].state == 'invoiced'">Faturado</t>
<t t-if="s['settlement'].state == 'except_invoice'">Exceção</t>
<t t-if="s['settlement'].state == 'cancel'">Cancelado</t>
</td>
<td><t t-esc="line_data['order_name']"/></td>
<td>
<t t-if="line_data['invoice_state'] == 'posted'">
<t t-if="line_data['payment_state'] == 'paid'">Pago</t>
<t t-if="line_data['payment_state'] == 'in_payment'">Em Pagamento</t>
<t t-if="line_data['payment_state'] == 'not_paid'">Não Pago</t>
<t t-if="line_data['payment_state'] == 'partial'">Parcial</t>
<t t-if="line_data['payment_state'] == 'reversed'">Estornado</t>
<t t-else=""><t t-esc="line_data['payment_state']"/></t>
</t>
<t t-if="line_data['invoice_state'] != 'posted'">
<span class="text-muted">-</span>
</t>
</td>
</tr>
</t>
</t>
</tbody>
</table>
</t>
<t t-if="uninvoiced_orders_data">
<h5 class="text-muted mt-4 mb-2">Pedidos Não Faturados</h5>
<table class="table table-striped">
<thead>
<tr>
<th>Pedido</th>
<th>Paciente</th>
<th>Data do Pedido</th>
<th>Oportunidade (CRM)</th>
<th t-if="show_all_values">Repasse</th>
</tr>
</thead>
<tbody>
<tr t-foreach="uninvoiced_orders_data" t-as="uo">
<td><t t-esc="uo['order_name']"/></td>
<td><t t-esc="uo['partner_name']"/></td>
<td><t t-esc="uo['order_date']"/></td>
<td><t t-esc="uo['opportunity_name']"/></td>
<td t-if="show_all_values">R$ <t t-esc="uo['commission_fmt']"/></td>
</tr>
</tbody>
</table>
</t>
</div>
</div>
</div>

          <div class="row mb-4">
            <div class="col-12">
              <h3>Oportunidades Perdidas</h3>
            </div>
          </div>
          <div class="row mb-4">
            <div class="col-12">
              <t t-if="not lost_data">
                <p class="text-muted">Nenhuma oportunidade perdida no período.</p>
              </t>
              <t t-if="lost_data">
                <table class="table table-striped">
                  <thead>
                    <tr>
                      <th>Oportunidade</th>
                      <th>Paciente</th>
                      <th>Data da Indicação</th>
                      <th>Indicação</th>
                      <th t-if="show_all_values">Expectativa</th>
                      <th>Motivo</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr t-foreach="lost_data" t-as="ld">
                      <td><t t-esc="ld['name']"/></td>
                      <td><t t-esc="ld['partner_name']"/></td>
                      <td><t t-esc="ld['date_str']"/></td>
                      <td><t t-esc="ld['referred_names']"/></td>
                      <td t-if="show_all_values">R$ <t t-esc="ld['expected_revenue_fmt']"/></td>
                      <td><t t-esc="ld['lost_reason']"/></td>
                    </tr>
                  </tbody>
                </table>
              </t>
            </div>
          </div>
          </div>
</t>
</template>

<template id="portal_repasse_rules" name="Tabela de Repasses">
<t t-call="portal.portal_layout">
<t t-set="breadcrumbs">
<ol class="breadcrumb">
<li class="breadcrumb-item"><a href="/my">Home</a></li>
<li class="breadcrumb-item active">Tabela de Repasses</li>
</ol>
</t>

<div class="o_portal_doctor">
<div class="row mb-4">
<div class="col-12">
<h3>Tabela de Repasses</h3>
<p class="text-muted">Regras de repasse para médicos sócios</p>
</div>
</div>

<div t-foreach="groups" t-as="group" class="mb-4">
<div class="row mb-2">
<div class="col-12">
<h4 class="o_repasse_group_title"><t t-esc="group['name']"/></h4>
</div>
</div>
<div class="row">
<div class="col-12">
<div class="table-responsive">
<table class="table table-striped o_repasse_table">
<thead>
<tr>
<th>Tipo</th>
<th>Convênio</th>
<th>Repasse</th>
<th>Base de Cálculo</th>
<th>Equação</th>
<th>Observação</th>
</tr>
</thead>
<tbody>
<tr t-foreach="group['rows']" t-as="r">
<td><t t-esc="r['tipo']"/></td>
<td><t t-esc="r['convenio']"/></td>
<td class="fw-bold" style="color:var(--iomr-primary)"><t t-esc="r['repasse']"/></td>
<td><t t-esc="r['base']"/></td>
<td style="font-size:11px"><t t-esc="r['equacao']"/></td>
<td style="font-size:11px;color:var(--iomr-text)"><t t-esc="r['obs']"/></td>
</tr>
</tbody>
</table>
</div>
</div>
</div>
</div>

<div class="row mt-4">
<div class="col-12">
<p class="text-muted" style="font-size:11px">* O médico cooperado recebe o pagamento e é realizado um encontro de contas com a Clínica.</p>
</div>
</div>
</div>
</t>
</template>
</odoo>
