<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_crm" model="ir.ui.view">
        <field name="name">res.users.form.inherit.crm</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="type_partner"/>
            </xpath>
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Função CRM" name="crm_role_group">
                    <field name="crm_role" widget="selection"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
