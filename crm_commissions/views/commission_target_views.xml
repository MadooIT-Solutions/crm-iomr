<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="commission_target_tree" model="ir.ui.view">
        <field name="name">commission.target.tree</field>
        <field name="model">commission.target</field>
        <field name="arch" type="xml">
            <list>
                <field name="member_id"/>
                <field name="target_date"/>
                <field name="individual_target_amount" widget="monetary"/>
                <field name="achieved_amount" widget="monetary"/>
                <field name="performance_pct" widget="progressbar"/>
                <field name="is_crm_score" optional="show"/>
                <field name="is_crm_ok" widget="boolean_toggle" optional="hide"/>
                <field name="quarterly_target_amount" widget="monetary" optional="show"/>
                <field name="quarter" optional="show"/>
                <field name="team_id" optional="hide"/>
                <field name="team_target_amount" widget="monetary" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="origin_type" optional="show"/>
                <field name="period_code" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="commission_target_form" model="ir.ui.view">
        <field name="name">commission.target.form</field>
        <field name="model">commission.target</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="period_code" readonly="1"/>
                            <field name="target_date" readonly="1"/>
                            <field name="quarter" readonly="1"/>
                            <field name="team_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="individual_target_amount" widget="monetary"/>
                            <field name="team_target_amount" widget="monetary"/>
                            <field name="achieved_amount" widget="monetary"/>
                            <field name="performance_pct" widget="progressbar"/>
                            <field name="quarterly_target_amount" widget="monetary"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="is_crm_score"/>
                            <field name="is_crm_ok"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="origin_type"/>
                            <field name="crm_target_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="commission_target_search" model="ir.ui.view">
        <field name="name">commission.target.search</field>
        <field name="model">commission.target</field>
        <field name="arch" type="xml">
            <search>
                <field name="member_id"/>
                <field name="period_code"/>
                <filter name="in_progress" string="In Progress"
                        domain="[('state','=','in_progress')]"/>
                <separator/>
                <filter name="auto_origin" string="Automáticas"
                        domain="[('origin_type','=','auto')]"/>
                <filter name="manual_origin" string="Manuais"
                        domain="[('origin_type','=','manual')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_member" string="Member"
                            context="{'group_by': 'member_id'}"/>
                    <filter name="group_by_period" string="Period"
                            context="{'group_by': 'period_code'}"/>
                    <filter name="group_by_state" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_target" model="ir.actions.act_window">
        <field name="name">Targets</field>
        <field name="res_model">commission.target</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="commission_target_search"/>
    </record>
</odoo>
