<odoo>
    <record id="group_crm_commission_user" model="res.groups">
        <field name="name">CRM Commission User</field>
        <field name="category_id" ref="base.module_category_sales_sales" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_crm_commission_manager" model="res.groups">
        <field name="name">CRM Commission Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales" />
        <field name="implied_ids" eval="[(4, ref('group_crm_commission_user'))]" />
    </record>
    <record id="group_crm_commission_orientadora" model="res.groups">
        <field name="name">Orientadora</field>
        <field name="category_id" ref="base.module_category_sales_sales" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_crm_commission_sdr" model="res.groups">
        <field name="name">SDR</field>
        <field name="category_id" ref="base.module_category_sales_sales" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_crm_commission_doctor" model="res.groups">
        <field name="name">Doctor (Portal)</field>
        <field name="category_id" ref="base.module_category_sales_sales" />
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]" />
    </record>
    <record id="group_crm_readonly" model="res.groups">
        <field name="name">Visualização Total</field>
        <field name="comment">Visualiza todos os documentos de CRM e Vendas, sem permissão de editar ou excluir</field>
        <field name="category_id" ref="base.module_category_sales_sales" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_crm_commission_manager'))]" />
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_crm_commission_manager'))]" />
    </record>

    <!-- Record rules -->
    <record id="rule_crm_target_own_only" model="ir.rule">
        <field name="name">CRM Target: own only (orientadora)</field>
        <field name="model_id" ref="model_crm_commission_target" />
        <field name="domain_force">[('agent_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_crm_commission_orientadora'))]" />
    </record>

    <!-- Sales users: read-only access to Dashboard data, restricted to own records -->
    <record id="rule_crm_target_own_only_sales" model="ir.rule">
        <field name="name">CRM Target: own only (sales)</field>
        <field name="model_id" ref="model_crm_commission_target" />
        <field name="domain_force">[('agent_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
    </record>

    <record id="rule_crm_target_own_only_sdr" model="ir.rule">
        <field name="name">CRM Target: own only (SDR)</field>
        <field name="model_id" ref="model_crm_commission_target" />
        <field name="domain_force">[('agent_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_crm_commission_sdr'))]" />
    </record>

    <record id="rule_crm_quarterly_bonus_own_only_sales" model="ir.rule">
        <field name="name">CRM Quarterly Bonus: own only (sales)</field>
        <field name="model_id" ref="model_crm_commission_quarterly_bonus" />
        <field name="domain_force">[('agent_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
    </record>

    <record id="rule_crm_quarterly_bonus_own_only_sdr" model="ir.rule">
        <field name="name">CRM Quarterly Bonus: own only (SDR)</field>
        <field name="model_id" ref="model_crm_commission_quarterly_bonus" />
        <field name="domain_force">[('agent_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_crm_commission_sdr'))]" />
    </record>

    <record id="rule_commission_settlement_own_only_sales" model="ir.rule">
        <field name="name">Commission Settlement: own only (sales)</field>
        <field name="model_id" ref="model_commission_settlement" />
        <field name="domain_force">[('agent_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
    </record>

    <record id="rule_commission_settlement_own_only_sdr" model="ir.rule">
        <field name="name">Commission Settlement: own only (SDR)</field>
        <field name="model_id" ref="model_commission_settlement" />
        <field name="domain_force">[('agent_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_crm_commission_sdr'))]" />
    </record>

    <record id="rule_commission_settlement_line_own_only_sales_sdr" model="ir.rule">
        <field name="name">Commission Settlement Line: own only (sales/SDR)</field>
        <field name="model_id" ref="commission_oca.model_commission_settlement_line" />
        <field name="domain_force">[('settlement_id.agent_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('group_crm_commission_sdr'))]" />
    </record>

    <record id="rule_commission_settlement_line_manager_all" model="ir.rule">
        <field name="name">Commission Settlement Line: manager all</field>
        <field name="model_id" ref="commission_oca.model_commission_settlement_line" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_crm_commission_manager')), (4, ref('sales_team.group_sale_manager'))]" />
    </record>

    <!-- CRM/Commission and Sales managers: full access, overriding the restricted
         'own only (sales)' rules. Group rules combine with OR, so for a manager
         who is also a salesman the effective domain becomes 'own only' OR 'all'
         = 'all' (create/write/unlink included; read access follows the manager
         ACL). -->
    <record id="rule_crm_target_manager_all" model="ir.rule">
        <field name="name">CRM Target: manager all</field>
        <field name="model_id" ref="model_crm_commission_target" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_crm_commission_manager')), (4, ref('sales_team.group_sale_manager'))]" />
    </record>
    <record id="rule_crm_quarterly_bonus_manager_all" model="ir.rule">
        <field name="name">CRM Quarterly Bonus: manager all</field>
        <field name="model_id" ref="model_crm_commission_quarterly_bonus" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_crm_commission_manager')), (4, ref('sales_team.group_sale_manager'))]" />
    </record>
    <record id="rule_commission_settlement_manager_all" model="ir.rule">
        <field name="name">Commission Settlement: manager all</field>
        <field name="model_id" ref="model_commission_settlement" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_crm_commission_manager')), (4, ref('sales_team.group_sale_manager'))]" />
    </record>

    <!-- Portal/Doctor: can only see their own leads -->
    <record id="rule_crm_lead_doctor_own" model="ir.rule">
        <field name="name">crm.lead: doctor own only</field>
        <field name="model_id" ref="model_crm_lead" />
        <field name="domain_force">[('doctor', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_crm_commission_doctor'))]" />
    </record>

    <!-- Portal/Doctor: can only see their own settlements -->
    <record id="rule_commission_settlement_doctor_own" model="ir.rule">
        <field name="name">commission.settlement: doctor own only</field>
        <field name="model_id" ref="model_commission_settlement" />
        <field name="domain_force">[('agent_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_crm_commission_doctor'))]" />
    </record>
</odoo>
