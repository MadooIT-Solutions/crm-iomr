<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Groups -->
        <record id="group_commission_manager" model="res.groups">
            <field name="name">Commission Manager</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
        </record>

        <record id="group_commission_orientadora" model="res.groups">
            <field name="name">Orientadora</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
        </record>

        <record id="group_commission_coordinator" model="res.groups">
            <field name="name">Commission Coordinator</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('group_commission_orientadora'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="rule_commission_member_orientadora_own" model="ir.rule">
            <field name="name">Orientadora: see only own member record</field>
            <field name="model_id" ref="model_commission_member"/>
            <field name="groups" eval="[(4, ref('group_commission_orientadora'))]"/>
            <field name="domain_force">[('partner_id.user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_commission_target_orientadora_own" model="ir.rule">
            <field name="name">Orientadora: see only own targets</field>
            <field name="model_id" ref="model_commission_target"/>
            <field name="groups" eval="[(4, ref('group_commission_orientadora'))]"/>
            <field name="domain_force">[('member_id.partner_id.user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_commission_sale_orientadora_own" model="ir.rule">
            <field name="name">Orientadora: see only own sales</field>
            <field name="model_id" ref="model_commission_sale"/>
            <field name="groups" eval="[(4, ref('group_commission_orientadora'))]"/>
            <field name="domain_force">[('owner_member_id.partner_id.user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_commission_result_orientadora_own" model="ir.rule">
            <field name="name">Orientadora: see only own results</field>
            <field name="model_id" ref="model_commission_result"/>
            <field name="groups" eval="[(4, ref('group_commission_orientadora'))]"/>
            <field name="domain_force">[('member_id.partner_id.user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_commission_recovery_orientadora_own" model="ir.rule">
            <field name="name">Orientadora: see only own recovery</field>
            <field name="model_id" ref="model_commission_recovery"/>
            <field name="groups" eval="[(4, ref('group_commission_orientadora'))]"/>
            <field name="domain_force">[('member_id.partner_id.user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
